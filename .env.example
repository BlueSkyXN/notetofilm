# 旧部署兼容与一次性导入示例。新部署使用 config.example.toml；Compose 不再读取这些业务参数。
# Copy to .env for Docker Compose. Local uvicorn reads exported environment variables, not this file.
# Generate a token locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=
# ACCESS_TOKEN remains a backwards-compatible admin-token fallback.
COOKIE_SECURE=0
ALLOWED_HOSTS=127.0.0.1,localhost,::1

# On first startup, model parameters seed data/config.toml. Edit them in /admin afterwards.
# API keys remain in the environment. Key-only configuration is allowed.
OPENAI_BASE=
OPENAI_API_KEY=
LLM_BASE=
LLM_API_KEY=
IMAGE_BASE=
IMAGE_API_KEY=
LLM_MODEL=origin-deepseek-v4-1-flash
LLM_WIRE_API=chat
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_REFERENCE_PROTOCOL=none
IMAGE_SIZE=1024x768
IMAGE_TIMEOUT=300
TTS_VOICE=zh-CN-YunxiNeural
FEISHU_WEBHOOK=

MAX_ACTIVE_TASKS=3
MAX_RENDER_TASKS=1
MAX_SCRIPT_CHARS=20000
REQUEST_BODY_TIMEOUT=30
MAX_UPLOAD_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=24000000
MAX_SCENES=30
MAX_NARRATION_CHARS=2000
MAX_IMAGE_REQUESTS_PER_TASK=60
MIN_FREE_DISK_MB=256
MAX_AUDIO_SECONDS=180
MAX_VIDEO_SECONDS=900
RENDER_TIMEOUT=1800

MAX_DAILY_TASKS=20
MAX_VISITOR_DAILY_TASKS=5
MAX_DAILY_LLM_REQUESTS=40
MAX_DAILY_IMAGE_REQUESTS=60
MAX_DAILY_AUDIO_REQUESTS=120
MAX_DAILY_RENDER_REQUESTS=30
